    // 与旧版独立脚本共用该标记，避免重复包装 visibilitychange。
    win.DIFY_DISABLE_VISIBILITY_REFRESH = true

    const eventTargetPrototype = win.EventTarget && win.EventTarget.prototype
    if (!eventTargetPrototype) return
    const originalAddEventListener = eventTargetPrototype.addEventListener
    const originalRemoveEventListener = eventTargetPrototype.removeEventListener
    const wrappedListeners = new WeakMap()

    const captureValue = options => typeof options === 'boolean' ? options : Boolean(options && options.capture)
    const shouldBlock = () => {
      if (!featureEnabled(win, 'visibilityGuard')) return false
      if (!isDifyWorkflowEditor(win.location)) return false
      if (VISIBILITY_BLOCK_MODE === 'all') return true
      return win.document.visibilityState === 'visible'
    }
    const wrapperFor = (listener, options) => {
      let wrappersByCapture = wrappedListeners.get(listener)
      if (!wrappersByCapture) {
