    if (runRequest) {
      state.apiRoot = runRequest.apiRoot || state.apiRoot
      const key = `${runRequest.appId}:${runRequest.runId}`
      const context = state.runs.get(key) || { appId: runRequest.appId, runId: runRequest.runId }
      if (runRequest.nodeExecutions) context.nodeExecutions = asList(payload)
      else context.runDetail = payload
      state.runs.set(key, context)
      state.activeRunKey = key
      scheduleScan(win)
      return
    }
    const logRequest = parseLogApi(url)
    if (logRequest) {
      state.apiRoot = logRequest.apiRoot || state.apiRoot
      const target = destinationFromLocation(win.location)
      if (target && target.appId === logRequest.appId) {
        state.destinationResponseReady = asList(payload).some(item => item && item.workflow_run && item.workflow_run.id === target.runId)
        scheduleScan(win)
      }
      return
    }
    const runListRequest = parseRunListApi(url)
    if (runListRequest) {
      state.apiRoot = runListRequest.apiRoot || state.apiRoot
      const target = testDestinationFromLocation(win.location)
      if (target && target.appId === runListRequest.appId) {
        state.destinationTestRunIndex = asList(payload).findIndex(item => item && item.id === target.runId)
        state.destinationResponseReady = state.destinationTestRunIndex >= 0
        if (!state.destinationResponseReady) {
          clearDestinationLoader(win)
          showToast(win.document, '目标测试运行不在最近 100 条调试历史中', 7000)
        }
        scheduleScan(win)
      }
      return
    }
    if (/\/workspaces\/current\/tools\/workflow(?:\?|$)/.test(url)) state.workflowTools = payload
  }

  function patchHistory(win) {
    for (const method of ['pushState', 'replaceState']) {
      const original = win.history[method]
      win.history[method] = function (...args) {
        const result = original.apply(this, args)
        state.destinationResponseReady = false
        state.destinationTestRunIndex = -1
        state.destinationTestHistoryOpened = false
        state.destinationOpenedKey = ''
        scheduleScan(win)
        return result
      }
    }
    win.addEventListener('popstate', () => {
      state.destinationResponseReady = false
      state.destinationTestRunIndex = -1
      state.destinationTestHistoryOpened = false
      state.destinationOpenedKey = ''
      scheduleScan(win)
    })
  }

  function activateDestinationLoader(win) {
    if (!anyDestinationFromLocation(win.location)) return
    const doc = win.document
    if (!doc.documentElement) {
      doc.addEventListener('DOMContentLoaded', () => activateDestinationLoader(win), { once: true })
      return
    }
    doc.documentElement.classList.add(LOADING_CLASS)

    const mount = () => {
      if (!doc.body || !doc.documentElement.classList.contains(LOADING_CLASS) || doc.getElementById(LOADER_ID)) return
      const loader = doc.createElement('div')
      loader.id = LOADER_ID
      loader.setAttribute('role', 'status')
      loader.setAttribute('aria-live', 'polite')
      const card = doc.createElement('div')
      const spinner = doc.createElement('span')
      spinner.className = 'dify-subworkflow-spinner'
      spinner.setAttribute('aria-hidden', 'true')
      const copy = doc.createElement('div')
      const title = doc.createElement('div')
      title.className = 'dify-subworkflow-loader-title'
      title.textContent = testDestinationFromLocation(win.location) ? '正在打开子工作流测试记录' : '正在打开子工作流日志'
      const detail = doc.createElement('div')
      detail.className = 'dify-subworkflow-loader-detail'
      detail.textContent = '正在加载应用并定位对应的运行记录…'
      copy.append(title, detail)
      card.append(spinner, copy)
      loader.appendChild(card)
      doc.body.appendChild(loader)
    }

    if (doc.body) mount()
    else doc.addEventListener('DOMContentLoaded', mount, { once: true })
    if (state.destinationLoaderTimer) win.clearTimeout(state.destinationLoaderTimer)
    state.destinationLoaderTimer = win.setTimeout(() => {
      clearDestinationLoader(win)
      if (doc.body) showToast(doc, '自动定位等待超时，已保留运行历史供手动查看', 6000)
    }, 20000)
  }

  function updateDestinationLoader(doc, detailText) {
    const detail = doc.querySelector(`#${LOADER_ID} .dify-subworkflow-loader-detail`)
    if (detail) detail.textContent = detailText
  }

  function clearDestinationLoader(win, delay = 0) {
    if (state.destinationLoaderTimer) {
      win.clearTimeout(state.destinationLoaderTimer)
      state.destinationLoaderTimer = 0
    }
    const finish = () => {
      const loader = win.document.getElementById(LOADER_ID)
      win.document.documentElement.classList.remove(LOADING_CLASS)
      if (!loader) return
      loader.classList.add('dify-subworkflow-loader-leaving')
      win.setTimeout(() => loader.remove(), 240)
    }
    if (delay) win.setTimeout(finish, delay)
    else finish()
  }

