// ==UserScript==
// @name         Dify PLUS
// @namespace    local.dify.workflow
// @version      1.3.1
// @description  Dify Plus for CX
// @author       Maersk china AI Team
// @match        https://dify-devs.maersk-digital.net/*
// @match        https://dify-cxprod.maersk-digital.net/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function (root, factory) {
  'use strict'

  const api = factory()
  if (typeof module === 'object' && module.exports) module.exports = api
  else api.boot(root)
})(typeof unsafeWindow !== 'undefined' ? unsafeWindow : globalThis, function () {
  'use strict'

  const QUERY_KEY = 'difySubworkflowRun'
  const TEST_QUERY_KEY = 'difySubworkflowTestRun'
  const TEST_CURSOR_KEY = 'difySubworkflowTestCursor'
  const BUTTON_CLASS = 'dify-subworkflow-log-button'
  const JSON_VIEW_CLASS = 'dify-decoded-json-view'
  const LOADER_ID = 'dify-subworkflow-loader'
  const LOADING_CLASS = 'dify-subworkflow-page-loading'
  const PLUS_BUTTON_ID = 'dify-plus-menu-button'
  const PLUS_PANEL_ID = 'dify-plus-settings-panel'
  const SETTINGS_STORAGE_KEY = 'dify-plus:settings:v1'
  const SCRIPT_VERSION = '1.3.1'
  // visible-refresh：只拦截切回页面后的刷新草稿；all：拦截工作流页面的全部 visibilitychange 回调。
  const VISIBILITY_BLOCK_MODE = 'visible-refresh'
  const DEBUG = false
  const CANDIDATE_DETAIL_LIMIT = 8
  const KEYWORD_RESULT_LIMIT = 20
  const NEARBY_RESULT_LIMIT = 100
  const DEFAULT_SETTINGS = Object.freeze({
    enabled: true,
    visibilityGuard: true,
    subworkflowJump: true,
    jsonParsedView: true,
    jumpLoading: true,
  })
  const SETTINGS_DEFINITIONS = Object.freeze([
    { key: 'enabled', name: '启用 Dify PLUS', description: '控制下方所有增强功能' },
    { key: 'visibilityGuard', name: '阻止切回刷新', description: '切回 Workflow 编辑器时不重新拉取草稿' },
    { key: 'subworkflowJump', name: '子流程日志直达', description: '在子 Workflow 节点右侧显示跳转按钮' },
    { key: 'jsonParsedView', name: 'JSON 解析视图', description: '提供嵌套 JSON 还原、着色和复制' },
    { key: 'jumpLoading', name: '跳转加载动画', description: '定位和打开子流程日志时显示加载状态' },
  ])
  const UUID_PATTERN = '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}'
  const UUID_RE = new RegExp(`^${UUID_PATTERN}$`)
  const RUN_API_RE = new RegExp(`/apps/(${UUID_PATTERN})/workflow-runs/(${UUID_PATTERN})(/node-executions)?(?:\\?|$)`)
  const RUN_LIST_API_RE = new RegExp(`/apps/(${UUID_PATTERN})/workflow-runs(?:\\?|$)`)
  const LOG_API_RE = new RegExp(`/apps/(${UUID_PATTERN})/workflow-app-logs(?:\\?|$)`)
  const APP_PATH_RE = new RegExp(`^(.*?)/app/(${UUID_PATTERN})/(?:logs|workflow)(?:/|$)`)

  const state = {
    rawFetch: null,
    apiRoot: '',
    authHeaders: {},
    runs: new Map(),
    activeRunKey: '',
    workflowTools: null,
    workflowToolsPromise: null,
    runDetailPromises: new Map(),
    childLocationPromises: new Map(),
    destinationResponseReady: false,
    destinationTestRunIndex: -1,
    destinationTestHistoryOpened: false,
    destinationOpenedKey: '',
    decodedEditors: new Map(),
    observer: null,
    scanTimer: 0,
    destinationLoaderTimer: 0,
    settings: null,
    settingsPanelOpen: false,
  }

  function loadSettings(win) {
    if (state.settings) return state.settings
    let saved = {}
    try {
      saved = JSON.parse(win.localStorage.getItem(SETTINGS_STORAGE_KEY) || '{}')
    } catch {}
    state.settings = { ...DEFAULT_SETTINGS, ...(saved && typeof saved === 'object' ? saved : {}) }
    return state.settings
  }

  function featureEnabled(win, key) {
    const settings = loadSettings(win)
    return settings.enabled && settings[key] !== false
  }

  function saveSettings(win, patch) {
    state.settings = { ...loadSettings(win), ...patch }
    try {
      win.localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(state.settings))
    } catch {}
    applySettings(win)
    return state.settings
  }

  function parseMaybeJson(value) {
    if (typeof value !== 'string') return value
    const trimmed = value.trim()
    if (!trimmed || !['{', '['].includes(trimmed[0])) return value
    try {
      return JSON.parse(trimmed)
    } catch {
      return value
    }
  }

  function decodeNestedJson(value, depth = 0, seen = new WeakSet()) {
    if (depth > 12) return value
    if (typeof value === 'string') {
      if (value.length > 2000000) return value
      let decoded = value
      for (let count = 0; count < 5; count++) {
        if (typeof decoded !== 'string') break
        const trimmed = decoded.trim()
        if (!trimmed || !['{', '['].includes(trimmed[0])) break
        try {
          const parsed = JSON.parse(trimmed)
          if (!parsed || typeof parsed !== 'object') break
          decoded = parsed
        } catch {
          break
        }
      }
      return decoded === value ? value : decodeNestedJson(decoded, depth + 1, seen)
    }
    if (!value || typeof value !== 'object' || seen.has(value)) return value
    seen.add(value)
    if (Array.isArray(value)) return value.map(item => decodeNestedJson(item, depth + 1, seen))
    const decoded = {}
    for (const [key, item] of Object.entries(value)) decoded[key] = decodeNestedJson(item, depth + 1, seen)
    return decoded
  }

  function formatDecodedEditorValue(value) {
    if (value === null || value === undefined) return ''
    let parsed = value
    if (typeof value === 'string') {
      try {
        parsed = JSON.parse(value)
      } catch {
        parsed = parseMaybeJson(value)
      }
    }
    const decoded = decodeNestedJson(parsed)
    if (typeof decoded === 'string') return decoded
    try {
      return JSON.stringify(decoded, null, 2)
    } catch {
      return String(value)
    }
  }

  function tokenizeJson(text) {
    const source = String(text || '')
    const tokens = []
    const pattern = /"(?:\\u[\da-fA-F]{4}|\\[^u]|[^\\"])*"|\b(?:true|false|null)\b|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|[{}[\],:]/g
    let cursor = 0
    let match
    while ((match = pattern.exec(source))) {
      if (match.index > cursor) tokens.push({ type: 'plain', text: source.slice(cursor, match.index) })
      const token = match[0]
      let type = 'punctuation'
      if (token[0] === '"') type = /^\s*:/.test(source.slice(pattern.lastIndex)) ? 'key' : 'string'
      else if (/^-?\d/.test(token)) type = 'number'
      else if (token === 'true' || token === 'false') type = 'boolean'
      else if (token === 'null') type = 'null'
      tokens.push({ type, text: token })
      cursor = pattern.lastIndex
    }
    if (cursor < source.length) tokens.push({ type: 'plain', text: source.slice(cursor) })
    return tokens
  }

  function renderHighlightedJson(doc, element, text) {
    const fragment = doc.createDocumentFragment()
    for (const token of tokenizeJson(text)) {
      if (token.type === 'plain') fragment.appendChild(doc.createTextNode(token.text))
      else {
        const span = doc.createElement('span')
        span.className = `dify-json-${token.type}`
        span.textContent = token.text
        fragment.appendChild(span)
      }
    }
    element.replaceChildren(fragment)
  }

  function decodeRunPayload(payload, nodeExecutions) {
    const decodeFields = item => {
      if (!item || typeof item !== 'object') return item
      const decoded = { ...item }
      for (const key of ['inputs', 'process_data', 'outputs']) {
        if (Object.prototype.hasOwnProperty.call(decoded, key)) decoded[key] = decodeNestedJson(decoded[key])
      }
      return decoded
    }
    if (!nodeExecutions) return decodeFields(payload)
    if (Array.isArray(payload)) return payload.map(decodeFields)
    if (payload && Array.isArray(payload.data)) return { ...payload, data: payload.data.map(decodeFields) }
    return payload
  }

  function asList(payload) {
    if (Array.isArray(payload)) return payload
    if (payload && Array.isArray(payload.data)) return payload.data
    if (payload && Array.isArray(payload.items)) return payload.items
    return []
  }

  function parseAppPath(pathname) {
    const match = String(pathname || '').match(APP_PATH_RE)
    return match ? { basePath: match[1] || '', appId: match[2] } : null
  }

  function parseRunApi(url) {
    let parsed
    try {
      parsed = new URL(String(url), 'https://placeholder.invalid')
    } catch {
      return null
    }
    const match = parsed.pathname.match(RUN_API_RE)
    if (!match) return null
    const marker = `/apps/${match[1]}/workflow-runs/${match[2]}`
    return {
      appId: match[1],
      runId: match[2],
      nodeExecutions: Boolean(match[3]),
      apiRoot: parsed.pathname.slice(0, parsed.pathname.indexOf(marker)),
    }
  }

  function parseRunListApi(url) {
    let parsed
    try {
      parsed = new URL(String(url), 'https://placeholder.invalid')
    } catch {
      return null
    }
    const match = parsed.pathname.match(RUN_LIST_API_RE)
    if (!match) return null
    const marker = `/apps/${match[1]}/workflow-runs`
    return {
      appId: match[1],
      apiRoot: parsed.pathname.slice(0, parsed.pathname.indexOf(marker)),
    }
  }

  function parseLogApi(url) {
    let parsed
    try {
      parsed = new URL(String(url), 'https://placeholder.invalid')
    } catch {
      return null
    }
    const match = parsed.pathname.match(LOG_API_RE)
    if (!match) return null
    const marker = `/apps/${match[1]}/workflow-app-logs`
    return {
      appId: match[1],
      apiRoot: parsed.pathname.slice(0, parsed.pathname.indexOf(marker)),
    }
  }

  function destinationFromLocation(locationLike) {
    const page = parseAppPath(locationLike.pathname)
    const runId = new URLSearchParams(locationLike.search || '').get(QUERY_KEY)
    if (!page || !runId || !UUID_RE.test(runId)) return null
    return { ...page, runId, key: `${page.appId}:${runId}` }
  }

  function testDestinationFromLocation(locationLike) {
    const page = parseAppPath(locationLike.pathname)
    const params = new URLSearchParams(locationLike.search || '')
    const runId = params.get(TEST_QUERY_KEY)
    const cursor = params.get(TEST_CURSOR_KEY)
    if (!page || !runId || !UUID_RE.test(runId) || !/\/workflow(?:\/|$)/.test(locationLike.pathname)) return null
    return { ...page, runId, cursor: cursor && UUID_RE.test(cursor) ? cursor : '', key: `test:${page.appId}:${runId}` }
  }

  function anyDestinationFromLocation(locationLike) {
    return destinationFromLocation(locationLike) || testDestinationFromLocation(locationLike)
  }

  function rewriteDestinationLogUrl(url, locationLike) {
    const target = destinationFromLocation(locationLike)
    if (!target) return String(url)
    let parsed
    try {
      parsed = new URL(String(url), locationLike.origin)
    } catch {
      return String(url)
    }
    const request = parseLogApi(parsed.href)
    if (!request || request.appId !== target.appId || parsed.origin !== locationLike.origin) return String(url)

    parsed.searchParams.set('keyword', target.runId)
    parsed.searchParams.set('page', '1')
    parsed.searchParams.set('limit', '20')
    parsed.searchParams.set('detail', 'true')
    parsed.searchParams.delete('status')
    parsed.searchParams.delete('created_at__after')
    parsed.searchParams.delete('created_at__before')
    return parsed.href
  }

  function rewriteDestinationTestRunUrl(url, locationLike) {
    const target = testDestinationFromLocation(locationLike)
    if (!target) return String(url)
    let parsed
    try {
      parsed = new URL(String(url), locationLike.origin)
    } catch {
      return String(url)
    }
    const request = parseRunListApi(parsed.href)
    if (!request || request.appId !== target.appId || parsed.origin !== locationLike.origin) return String(url)

    parsed.searchParams.set('limit', '100')
    parsed.searchParams.set('triggered_from', 'debugging')
    if (target.cursor) parsed.searchParams.set('last_id', target.cursor)
    else parsed.searchParams.delete('last_id')
    parsed.searchParams.delete('status')
    return parsed.href
  }

  function rewriteDestinationUrl(url, locationLike) {
    return rewriteDestinationTestRunUrl(rewriteDestinationLogUrl(url, locationLike), locationLike)
  }

  function isWorkflowToolGraphNode(node) {
    const data = node && node.data
    return Boolean(
      data &&
        String(data.type || '').toLowerCase() === 'tool' &&
        String(data.provider_type || data.providerType || '').toLowerCase() === 'workflow',
    )
  }

  function findGraphNode(runDetail, nodeId) {
    const nodes = runDetail && runDetail.graph && runDetail.graph.nodes
    return Array.isArray(nodes) ? nodes.find(node => String(node.id) === String(nodeId)) || null : null
  }

  function resolveChildAppId(providers, graphNode) {
    if (!graphNode || !graphNode.data) return null
    const providerId = String(graphNode.data.provider_id || graphNode.data.providerId || '')
    const toolName = String(graphNode.data.tool_name || graphNode.data.toolName || '')
    const rows = asList(providers)
    const provider = rows.find(item => {
      if (!item) return false
      const idMatch = [item.id, item.provider_id, item.name].some(value => String(value || '') === providerId)
      if (!idMatch) return false
      if (!toolName || !Array.isArray(item.tools) || item.tools.length === 0) return true
      return item.tools.some(tool => [tool.name, tool.id].some(value => String(value || '') === toolName))
    })
    return provider && (provider.workflow_app_id || provider.workflowAppId || provider.app_id) || null
  }

  function normalizedScalar(value) {
    if (value === null || value === undefined) return ''
    if (typeof value === 'string') return value.trim().replace(/\s+/g, ' ').toLocaleLowerCase()
    if (typeof value === 'number' || typeof value === 'boolean') return String(value)
    return ''
  }

  function flattenComparable(value, path = [], output = []) {
    value = parseMaybeJson(value)
    if (output.length >= 100) return output
    if (value === null || value === undefined) return output
    if (typeof value !== 'object') {
      const scalar = normalizedScalar(value)
      const key = String(path[path.length - 1] || '').toLocaleLowerCase()
      if (scalar && !key.startsWith('sys.') && !['files', 'file', 'timestamp'].includes(key))
        output.push({ key, path: path.join('.').toLocaleLowerCase(), value: scalar })
      return output
    }
    if (Array.isArray(value)) {
      value.slice(0, 30).forEach((item, index) => flattenComparable(item, [...path, String(index)], output))
      return output
    }
    Object.entries(value).forEach(([key, item]) => {
      const lower = key.toLocaleLowerCase()
      if (lower.startsWith('sys.') || ['files', 'file', '__dify__'].includes(lower)) return
      flattenComparable(item, [...path, key], output)
    })
    return output
  }

  function selectLogSearchKeyword(inputs) {
    const ignored = new Set([
      'true', 'false', 'null', 'none', 'unknown', 'succeeded', 'failed', 'running', 'stopped',
    ])
    const candidates = flattenComparable(inputs)
      .map(item => {
        const value = item.value
        if (value.length < 4 || value.length > 30 || ignored.has(value)) return null
        if (/^https?:\/\//.test(value) || /\s{2,}/.test(value)) return null

        const signal = `${item.path}.${item.key}`.replace(/[^a-z0-9]/g, '')
        let score = 0
        if (/case(?:number|no|id)/.test(signal)) score += 140
        else if (/(?:ticket|request|booking|shipment|container)(?:number|no|id)/.test(signal)) score += 120
        else if (/(?:case|ticket|booking|shipment|container)$/.test(signal)) score += 90
        else if (/(?:number|no|id)$/.test(signal)) score += 55
        if (UUID_RE.test(value)) score += 70
        if (/\d/.test(value)) score += 18
        if (/^[a-z0-9][a-z0-9._\/-]*$/.test(value)) score += 14
        if (value.length >= 6 && value.length <= 24) score += 8
        if (value.includes('@')) score -= 25
        return { value, score }
      })
      .filter(Boolean)
      .sort((left, right) => right.score - left.score || left.value.length - right.value.length)
    return candidates.length && candidates[0].score >= 35 ? candidates[0].value : ''
  }

  function prefilterCandidateLogs(nodeExecution, logs, limit = CANDIDATE_DETAIL_LIMIT) {
    const nodeStart = toEpochSeconds(nodeExecution && nodeExecution.created_at)
    const nodeDuration = Number(nodeExecution && nodeExecution.elapsed_time) || 0
    return asList(logs)
      .map(log => {
        const run = log && log.workflow_run
        if (!run || !UUID_RE.test(String(run.id))) return null
        const startDelta = nodeStart ? Math.abs(toEpochSeconds(run.created_at) - nodeStart) : 999999
        const durationDelta = nodeDuration
          ? Math.abs((Number(run.elapsed_time) || 0) - nodeDuration)
          : 999999
        return { log, startDelta, durationDelta }
      })
      .filter(Boolean)
      .sort((left, right) =>
        left.startDelta - right.startDelta ||
        left.durationDelta - right.durationDelta ||
        toEpochSeconds(right.log.workflow_run.created_at) - toEpochSeconds(left.log.workflow_run.created_at),
      )
      .slice(0, Math.max(1, limit))
      .map(item => item.log)
  }

  function inputsContainKeyword(inputs, keyword) {
    const needle = normalizedScalar(keyword)
    return Boolean(needle && flattenComparable(inputs).some(item =>
      item.value === needle || (needle.length >= 8 && item.value.includes(needle)),
    ))
  }

  function inputSimilarity(parentInputs, childInputs) {
    const parent = flattenComparable(parentInputs)
    const child = flattenComparable(childInputs)
    if (!parent.length || !child.length) return { score: 0, comparable: parent.length }

    let matched = 0
    let total = 0
    for (const left of parent) {
      const weight = Math.min(Math.max(left.value.length, 2), 40)
      total += weight
      const sameKey = child.some(right => right.key === left.key && right.value === left.value)
      const sameValue = child.some(right => right.value === left.value)
      const contained = left.value.length >= 8 && child.some(right =>
        right.value.includes(left.value) || left.value.includes(right.value),
      )
      if (sameKey) matched += weight
      else if (sameValue) matched += weight * 0.9
      else if (contained) matched += weight * 0.55
    }
    return { score: total ? matched / total : 0, comparable: parent.length }
  }

  function toEpochSeconds(value) {
    const number = Number(value)
    if (Number.isFinite(number)) return number > 100000000000 ? number / 1000 : number
    const parsed = Date.parse(String(value || ''))
    return Number.isFinite(parsed) ? parsed / 1000 : 0
  }

  function rankCandidates(nodeExecution, candidateDetails) {
    const nodeStart = toEpochSeconds(nodeExecution && nodeExecution.created_at)
    const nodeDuration = Number(nodeExecution && nodeExecution.elapsed_time) || 0
    return candidateDetails
      .filter(Boolean)
      .map(detail => {
        const similarity = inputSimilarity(nodeExecution && nodeExecution.inputs, detail.inputs)
        const startDelta = nodeStart ? Math.abs(toEpochSeconds(detail.created_at) - nodeStart) : 999999
        const durationDelta = nodeDuration
          ? Math.abs((Number(detail.elapsed_time) || 0) - nodeDuration)
          : 999999
        return {
          detail,
          inputScore: similarity.score,
          comparableInputs: similarity.comparable,
          startDelta,
          durationDelta,
          score: similarity.score * 10000 - Math.min(startDelta, 300) * 20 - Math.min(durationDelta, 300) * 3,
        }
      })
      .sort((a, b) => b.score - a.score)
  }

  function candidatesAreAmbiguous(ranked) {
    if (ranked.length < 2) return false
    const [first, second] = ranked
    if (first.comparableInputs && first.inputScore < 0.35) return true
    return (
      Math.abs(first.inputScore - second.inputScore) < 0.03 &&
      Math.abs(first.startDelta - second.startDelta) < 1 &&
      Math.abs(first.durationDelta - second.durationDelta) < 1
    )
  }

  function runSourceFromPath(pathname) {
    const path = String(pathname || '')
    if (/\/app\/[0-9a-fA-F-]+\/workflow(?:\/|$)/.test(path)) return 'debugging'
    return 'logs'
  }

  function runSourceForContext(pathname, context) {
    const triggeredFrom = context && context.runDetail && context.runDetail.triggered_from
    if (triggeredFrom) return triggeredFrom === 'debugging' ? 'debugging' : 'logs'
    return runSourceFromPath(pathname)
  }

  function runDetailMatchesSource(detail, source) {
    if (!detail) return false
    // 当前 Dify 的 WorkflowRunDetailResponse 不包含 triggered_from。
    // 来源隔离由列表接口完成；仅在旧版/定制版确实返回该字段时做额外校验。
    const triggeredFrom = detail.triggered_from
    if (!triggeredFrom) return true
    return source === 'debugging' ? triggeredFrom === 'debugging' : triggeredFrom !== 'debugging'
  }

  function debugRunsInTimeWindow(nodeExecution, runs, secondsPadding = 180) {
    const created = toEpochSeconds(nodeExecution && nodeExecution.created_at)
    const finished = toEpochSeconds(nodeExecution && nodeExecution.finished_at) ||
      created + (Number(nodeExecution && nodeExecution.elapsed_time) || 0)
    return asList(runs)
      .filter(run => {
        if (!run || !UUID_RE.test(String(run.id))) return false
        if (run.triggered_from && run.triggered_from !== 'debugging') return false
        if (!created) return true
        const timestamp = toEpochSeconds(run.created_at)
        return timestamp >= created - secondsPadding && timestamp <= finished + secondsPadding
      })
      .map(workflow_run => ({ workflow_run }))
  }

  function buildChildLogUrl(origin, basePath, appId, runId) {
    if (!UUID_RE.test(String(appId)) || !UUID_RE.test(String(runId))) throw new Error('无效的应用或运行 ID')
    const prefix = String(basePath || '').replace(/\/$/, '')
    const target = new URL(`${prefix}/app/${appId}/logs`, origin)
    target.searchParams.set(QUERY_KEY, runId)
    return target.href
  }

  function buildChildTestRunUrl(origin, basePath, appId, runId, cursor = '') {
    if (!UUID_RE.test(String(appId)) || !UUID_RE.test(String(runId))) throw new Error('无效的应用或运行 ID')
    const prefix = String(basePath || '').replace(/\/$/, '')
    const target = new URL(`${prefix}/app/${appId}/workflow`, origin)
    target.searchParams.set(TEST_QUERY_KEY, runId)
    if (cursor && UUID_RE.test(String(cursor))) target.searchParams.set(TEST_CURSOR_KEY, cursor)
    return target.href
  }

  function deepFindRunId(value, parentRunId, depth = 0, seen = new Set()) {
    value = parseMaybeJson(value)
    if (!value || typeof value !== 'object' || depth > 7 || seen.has(value)) return null
    seen.add(value)
    for (const [key, item] of Object.entries(value)) {
      const lower = key.toLocaleLowerCase()
      if (
        ['child_workflow_run_id', 'sub_workflow_run_id', 'workflow_run_id', 'run_id'].includes(lower) &&
        typeof item === 'string' && UUID_RE.test(item) && item !== parentRunId
      ) return item
    }
    for (const item of Object.values(value)) {
      const found = deepFindRunId(item, parentRunId, depth + 1, seen)
      if (found) return found
    }
    return null
  }

  function boot(win) {
    if (!win || !win.document || !/^dify-(?:devs|cxprod)\.maersk-digital\.net$/i.test(win.location.hostname)) return
    if (win.__DIFY_PLUS_INSTALLED__) return
    win.__DIFY_PLUS_INSTALLED__ = true
    loadSettings(win)
    installVisibilityRefreshGuard(win)
    patchNetwork(win)
    installStyles(win.document)
    if (featureEnabled(win, 'subworkflowJump') && featureEnabled(win, 'jumpLoading'))
      activateDestinationLoader(win)
    patchHistory(win)
    startObserver(win)
    win.addEventListener('resize', () => scheduleScan(win), { passive: true })
