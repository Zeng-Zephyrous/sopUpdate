  function updatePendingWindow(pending, message) {
    if (!pending || pending.closed) return
    try {
      const detail = pending.document.getElementById('dify-subworkflow-pending-detail')
      if (detail) detail.textContent = message
    } catch {}
  }

  function startObserver(win) {
    const begin = () => {
      if (!win.document.body || state.observer) return
      state.observer = new MutationObserver(() => scheduleScan(win))
      state.observer.observe(win.document.body, { childList: true, subtree: true })
    }
    if (win.document.body) begin()
    else win.document.addEventListener('DOMContentLoaded', begin, { once: true })
  }

  function removeSubworkflowButtons(doc) {
    for (const button of doc.querySelectorAll(`.${BUTTON_CLASS}`)) button.remove()
  }

  function removeJsonEnhancements() {
    for (const [card, enhancement] of state.decodedEditors) {
      if (enhancement.original && enhancement.original.isConnected) enhancement.original.style.display = ''
      if (enhancement.pre) enhancement.pre.remove()
      if (enhancement.toggle) enhancement.toggle.remove()
      if (enhancement.copy) enhancement.copy.remove()
      state.decodedEditors.delete(card)
    }
  }

  function applySettings(win) {
    syncPlusButton(win)
    if (!featureEnabled(win, 'subworkflowJump')) removeSubworkflowButtons(win.document)
    if (!featureEnabled(win, 'jsonParsedView')) removeJsonEnhancements()
    const loadingEnabled = featureEnabled(win, 'subworkflowJump') && featureEnabled(win, 'jumpLoading')
    if (!loadingEnabled) clearDestinationLoader(win)
    else if (anyDestinationFromLocation(win.location) && !win.document.getElementById(LOADER_ID))
      activateDestinationLoader(win)
    scheduleScan(win)
  }

  function scheduleScan(win) {
    if (state.scanTimer) return
    state.scanTimer = win.setTimeout(() => {
      state.scanTimer = 0
      injectPlusMenuButton(win)
      if (featureEnabled(win, 'subworkflowJump')) {
        tryAutoOpenDestination(win)
        injectButtons(win)
      }
      if (featureEnabled(win, 'jsonParsedView')) enhanceJsonEditors(win)
    }, 120)
  }

  function reactJsonEditorValue(element) {
    let current = element
    for (let elementDepth = 0; current && elementDepth < 5; elementDepth++, current = current.parentElement) {
      for (const key of Object.getOwnPropertyNames(current)) {
        if (!key.startsWith('__reactFiber$') && !key.startsWith('__reactInternalInstance$')) continue
        let fiber = current[key]
        for (let depth = 0; fiber && depth < 24; depth++, fiber = fiber.return) {
          const props = fiber.memoizedProps || fiber.pendingProps
          if (!props) continue
          if (props.codeLanguages === 'json' && typeof props.value === 'string') return props.value
          if (props.language === 'json' && props.readOnly && Object.prototype.hasOwnProperty.call(props, 'value'))
            return typeof props.value === 'string' ? JSON.stringify(props.value) : JSON.stringify(props.value, null, 2)
        }
      }
    }
    return null
  }

  function findEditorContentRoot(card) {
    let current = card.querySelector('.monaco-editor')
    if (!current) return null
    while (current.parentElement && current.parentElement !== card) current = current.parentElement
    return current.parentElement === card ? current : null
  }

  function copyText(win, value) {
    if (win.navigator.clipboard && win.navigator.clipboard.writeText)
      return win.navigator.clipboard.writeText(value)
    const textarea = win.document.createElement('textarea')
    textarea.value = value
    textarea.style.position = 'fixed'
    textarea.style.opacity = '0'
    win.document.body.appendChild(textarea)
    textarea.select()
    win.document.execCommand('copy')
    textarea.remove()
    return Promise.resolve()
  }

  function enhanceJsonEditors(win) {
    if (!/\/app\/[0-9a-fA-F-]+\/logs(?:\/|$)/.test(win.location.pathname)) return
    const titleElements = [...win.document.querySelectorAll('div.system-xs-semibold-uppercase.text-text-secondary')]
    for (const title of titleElements) {
      const header = title.parentElement
      const card = header && header.parentElement
      if (!header || !card || !card.querySelector('.monaco-editor')) continue
      const source = reactJsonEditorValue(card)
      if (source === null) continue
      const decoded = formatDecodedEditorValue(source)
      let enhancement = state.decodedEditors.get(card)
      if (!enhancement) {
        const original = findEditorContentRoot(card)
        if (!original) continue
        const pre = win.document.createElement('pre')
        pre.className = JSON_VIEW_CLASS
        const controls = header.lastElementChild
        if (!controls) continue
        const toggle = win.document.createElement('button')
        toggle.type = 'button'
        toggle.className = 'dify-json-action'
        toggle.textContent = '解析视图'
        toggle.title = '切换到自动还原嵌套 JSON 的语法高亮视图'
        toggle.addEventListener('click', event => {
          event.preventDefault()
          event.stopPropagation()
          const parsedVisible = pre.style.display !== 'none'
          pre.style.display = parsedVisible ? 'none' : 'block'
          original.style.display = parsedVisible ? '' : 'none'
          toggle.textContent = parsedVisible ? '解析视图' : '官方视图'
          toggle.title = parsedVisible
            ? '切换到自动还原嵌套 JSON 的语法高亮视图'
            : '切换回 Dify 官方输出'
        })
        const copy = win.document.createElement('button')
        copy.type = 'button'
        copy.className = 'dify-json-action'
        copy.textContent = '复制解析'
        copy.addEventListener('click', event => {
          event.preventDefault()
          event.stopPropagation()
          copyText(win, pre.textContent || '').then(() => {
            copy.textContent = '已复制 ✓'
            win.setTimeout(() => { copy.textContent = '复制解析' }, 1600)
          }).catch(() => showToast(win.document, '复制失败，请选中文本后手动复制', 4000))
        })
        controls.prepend(copy, toggle)
        pre.style.display = 'none'
        original.before(pre)
        enhancement = { source: null, pre, original, toggle, copy }
        state.decodedEditors.set(card, enhancement)
      }
      if (enhancement.source !== source) {
        enhancement.source = source
        renderHighlightedJson(win.document, enhancement.pre, decoded)
      }
    }
  }

  function tryAutoOpenDestination(win) {
    const testTarget = testDestinationFromLocation(win.location)
    if (testTarget) {
      tryAutoOpenTestDestination(win, testTarget)
      return
    }
    const target = destinationFromLocation(win.location)
    if (!target || state.destinationOpenedKey === target.key || !state.destinationResponseReady) return
    const rows = [...win.document.querySelectorAll('tbody tr')].filter(row => row.offsetParent !== null)
    if (!rows.length) return
    state.destinationOpenedKey = target.key
    updateDestinationLoader(win.document, '已定位运行记录，正在打开详情…')
    rows[0].click()
    clearDestinationLoader(win, 500)
  }

  function testRunHistoryButton(win) {
    return [...win.document.querySelectorAll('button')].find(button =>
      isVisibleElement(win, button) && button.querySelector('span.i-custom-vender-line-time-clock-play'),
    ) || null
  }

  function visibleTestRunRows(win) {
    const rows = []
    for (const label of win.document.querySelectorAll('div')) {
      if (!/^Test (?:Run|Chat)(?:\s|\(|$)/.test(String(label.textContent || '').trim())) continue
      const row = label.closest('div.cursor-pointer')
      if (row && isVisibleElement(win, row) && !rows.includes(row)) rows.push(row)
    }
    return rows
  }

  function tryAutoOpenTestDestination(win, target) {
    if (state.destinationOpenedKey === target.key) return
    if (!state.destinationTestHistoryOpened) {
      const button = testRunHistoryButton(win)
      if (!button) return
      state.destinationTestHistoryOpened = true
      updateDestinationLoader(win.document, '正在读取子 Workflow 的测试运行历史…')
      button.click()
      return
    }
    if (!state.destinationResponseReady || state.destinationTestRunIndex < 0) return
    const rows = visibleTestRunRows(win)
    const row = rows[state.destinationTestRunIndex]
    if (!row) return
    state.destinationOpenedKey = target.key
    updateDestinationLoader(win.document, '已定位测试运行，正在加载 Trace…')
    row.click()
    clearDestinationLoader(win, 700)
  }

  function reactNodeInfo(element) {
    let current = element
    for (let elementDepth = 0; current && elementDepth < 5; elementDepth++, current = current.parentElement) {
      for (const key of Object.getOwnPropertyNames(current)) {
        if (!key.startsWith('__reactFiber$') && !key.startsWith('__reactInternalInstance$')) continue
        let fiber = current[key]
        for (let depth = 0; fiber && depth < 20; depth++, fiber = fiber.return) {
          if (fiber.memoizedProps && fiber.memoizedProps.nodeInfo) return fiber.memoizedProps.nodeInfo
          if (fiber.pendingProps && fiber.pendingProps.nodeInfo) return fiber.pendingProps.nodeInfo
        }
      }
    }
    return null
  }

  function contextForNodeInfo(nodeInfo) {
    const active = state.runs.get(state.activeRunKey)
    if (active && active.nodeExecutions && active.nodeExecutions.some(item => item.id === nodeInfo.id)) return active
    for (const context of [...state.runs.values()].reverse()) {
      if (context.nodeExecutions && context.nodeExecutions.some(item => item.id === nodeInfo.id)) return context
    }
    return null
  }

  function fallbackNodeInfo(header) {
    const context = state.runs.get(state.activeRunKey)
    if (!context || !context.nodeExecutions) return null
    const title = [...header.querySelectorAll('div')]
      .map(item => item.textContent && item.textContent.trim())
      .find(text => text && text.length < 160)
    if (!title) return null
    const matches = context.nodeExecutions.filter(item => item.title === title)
    return matches.length === 1 ? matches[0] : null
  }

  function injectButtons(win) {
    const page = parseAppPath(win.location.pathname)
    if (!page) return
    const headers = [...win.document.querySelectorAll('div.cursor-pointer')]
      .filter(element => element.classList.contains('items-center') && !element.querySelector(`.${BUTTON_CLASS}`))
    for (const header of headers) {
      const nodeInfo = reactNodeInfo(header) || fallbackNodeInfo(header)
      if (!nodeInfo || String(nodeInfo.node_type).toLocaleLowerCase() !== 'tool') continue
      const context = contextForNodeInfo(nodeInfo)
      if (!context || !context.runDetail) continue
      const graphNode = findGraphNode(context.runDetail, nodeInfo.node_id)
      if (!isWorkflowToolGraphNode(graphNode)) continue

      const button = win.document.createElement('button')
      button.type = 'button'
      button.className = BUTTON_CLASS
      const source = runSourceForContext(win.location.pathname, context)
      button.textContent = source === 'debugging' ? '子测试 ↗' : '子日志 ↗'
      button.title = source === 'debugging'
        ? '打开这次调用对应的子工作流测试运行 Trace'
        : '打开这次调用对应的子工作流正式日志'
      button.addEventListener('click', event => {
        event.preventDefault()
        event.stopPropagation()
        event.stopImmediatePropagation()
        locateAndOpen(win, button, context, nodeInfo, graphNode)
      })
      header.appendChild(button)
    }
  }

  async function apiGet(win, path, params = {}) {
    const currentPage = parseAppPath(win.location.pathname)
    const apiRoot = state.apiRoot || `${currentPage && currentPage.basePath || ''}/console/api`
    const url = new URL(`${apiRoot}${path}`, win.location.origin)
    Object.entries(params).forEach(([key, value]) => {
      if (value !== null && value !== undefined && value !== '') url.searchParams.set(key, String(value))
    })
    const headers = new Headers({ Accept: 'application/json', ...state.authHeaders })
    if (!headers.has('authorization')) {
      const token = win.localStorage && (win.localStorage.getItem('access_token') || win.localStorage.getItem('console_token'))
      if (token) headers.set('authorization', `Bearer ${token}`)
    }
    const response = await state.rawFetch(url.href, { credentials: 'include', headers })
    if (!response.ok) {
      if (response.status === 401 || response.status === 403) throw new Error('登录已失效或没有子工作流日志权限')
      throw new Error(`Dify 接口返回 HTTP ${response.status}`)
    }
    return response.json()
  }

  async function workflowTools(win) {
    if (state.workflowTools) return state.workflowTools
    if (!state.workflowToolsPromise) {
      state.workflowToolsPromise = apiGet(win, '/workspaces/current/tools/workflow')
        .then(payload => (state.workflowTools = payload))
        .finally(() => { state.workflowToolsPromise = null })
    }
    return state.workflowToolsPromise
  }

  async function childAppId(win, graphNode) {
    const providerId = graphNode.data.provider_id || graphNode.data.providerId
    const fromList = resolveChildAppId(await workflowTools(win), graphNode)
    if (fromList) return fromList
    const detail = await apiGet(win, '/workspaces/current/tool-provider/workflow/get', { workflow_tool_id: providerId })
    return detail.workflow_app_id || detail.app_id || null
  }

  function cachedRunDetail(win, appId, runId) {
    const key = `${appId}:${runId}`
    if (state.runDetailPromises.has(key)) return state.runDetailPromises.get(key)
    const promise = apiGet(win, `/apps/${appId}/workflow-runs/${runId}`)
    state.runDetailPromises.set(key, promise)
    promise.catch(() => {
      if (state.runDetailPromises.get(key) === promise) state.runDetailPromises.delete(key)
    })
    return promise
  }

  function mergeRunDetails(...groups) {
    const merged = new Map()
    groups.flat().filter(Boolean).forEach(detail => merged.set(detail.id, detail))
    return [...merged.values()]
  }

  async function candidateRunDetails(win, appId, nodeExecution, secondsPadding, keyword = '', onProgress = () => {}) {
    const created = toEpochSeconds(nodeExecution.created_at)
    const finished = toEpochSeconds(nodeExecution.finished_at) || created + (Number(nodeExecution.elapsed_time) || 0)
    const params = { page: 1, limit: keyword ? KEYWORD_RESULT_LIMIT : NEARBY_RESULT_LIMIT }
    if (keyword) params.keyword = keyword
    if (created) params.created_at__after = new Date((created - secondsPadding) * 1000).toISOString()
    if (finished) params.created_at__before = new Date((finished + secondsPadding) * 1000).toISOString()
    const logs = asList(await apiGet(win, `/apps/${appId}/workflow-app-logs`, params))
    const shortlisted = prefilterCandidateLogs(nodeExecution, logs)
    const mode = keyword ? `关键词“${keyword}”` : `${secondsPadding} 秒时间窗口`
    onProgress(`通过${mode}找到 ${logs.length} 条，正在比较最接近的 ${shortlisted.length} 条…`)
    const values = await Promise.all(shortlisted.map(item =>
      cachedRunDetail(win, appId, item.workflow_run.id).catch(() => null),
    ))
    return values.filter(Boolean)
  }

  async function candidateDebugRunDetails(win, appId, nodeExecution, secondsPadding = 180, onProgress = () => {}) {
    const created = toEpochSeconds(nodeExecution.created_at)
    const lowerBound = created ? created - secondsPadding : 0
    const runs = []
    let lastId = ''
    let hasMore = true

    for (let page = 0; page < 8 && hasMore; page++) {
      const params = { limit: 100, triggered_from: 'debugging' }
      if (lastId) params.last_id = lastId
      const pageCursor = lastId
      onProgress(`正在扫描子 Workflow 的测试运行历史（已读取 ${runs.length} 条）…`)
      const payload = await apiGet(win, `/apps/${appId}/workflow-runs`, params)
      const pageRuns = asList(payload)
      runs.push(...pageRuns.map(run => ({ ...run, __difyPlusCursor: pageCursor })))
      hasMore = Boolean(payload && payload.has_more) && pageRuns.length > 0
      lastId = pageRuns.length ? String(pageRuns[pageRuns.length - 1].id || '') : ''
      const oldest = pageRuns.length ? toEpochSeconds(pageRuns[pageRuns.length - 1].created_at) : 0
      if (!lastId || (lowerBound && oldest && oldest <= lowerBound)) break
    }

    if (!runs.length)
      throw new Error('子 Workflow 的测试历史接口返回 0 条 debugging 记录')
    const matchingRuns = debugRunsInTimeWindow(nodeExecution, runs, secondsPadding)
    if (!matchingRuns.length) {
      const nodeStart = toEpochSeconds(nodeExecution.created_at)
      const nearestDelta = nodeStart
        ? Math.min(...runs.map(run => Math.abs(toEpochSeconds(run.created_at) - nodeStart)).filter(Number.isFinite))
        : NaN
      const deltaText = Number.isFinite(nearestDelta) ? `，最近记录相差 ${nearestDelta.toFixed(0)} 秒` : ''
      throw new Error(`测试历史返回 ${runs.length} 条，但 ${secondsPadding} 秒时间窗口内为 0 条${deltaText}`)
    }
    const shortlisted = prefilterCandidateLogs(nodeExecution, matchingRuns)
    onProgress(`仅在测试运行中找到 ${matchingRuns.length} 条时间候选，正在比较最接近的 ${shortlisted.length} 条…`)
    const details = await Promise.all(shortlisted.map(async item => {
      const detail = await cachedRunDetail(win, appId, item.workflow_run.id).catch(() => null)
      return detail ? { ...detail, __difyPlusCursor: item.workflow_run.__difyPlusCursor || '' } : null
    }))
    const available = details.filter(detail => runDetailMatchesSource(detail, 'debugging'))
    if (!available.length)
      throw new Error(`找到 ${shortlisted.length} 条测试候选，但运行详情均无法读取`)
    return available
  }

  async function locateChildRun(win, context, nodeExecution, graphNode, onProgress = () => {}) {
    onProgress('正在读取子工作流配置…')
    const appId = await childAppId(win, graphNode)
    if (!appId || !UUID_RE.test(String(appId))) throw new Error('无法从 workflow tool 配置解析子应用 ID')

    const source = runSourceForContext(win.location.pathname, context)
    const directId = deepFindRunId(
      {
        process_data: nodeExecution.process_data,
        outputs: nodeExecution.outputs,
        execution_metadata: nodeExecution.execution_metadata,
        extras: nodeExecution.extras,
      },
      context.runId,
    )
    if (directId) {
      onProgress('已取得子 Run ID，正在验证运行记录…')
      const detail = await cachedRunDetail(win, appId, directId).catch(() => null)
      if (runDetailMatchesSource(detail, source))
        return { appId, ranked: rankCandidates(nodeExecution, [detail]), direct: true, source }
    }

    if (source === 'debugging') {
      onProgress('当前 Trace 来自测试运行，只查询 debugging 历史…')
      const details = await candidateDebugRunDetails(win, appId, nodeExecution, 180, onProgress)
      if (!details.length) throw new Error('没有在子 Workflow 的测试运行历史中找到时间匹配记录')
      return { appId, ranked: rankCandidates(nodeExecution, details), direct: false, source }
    }

    const keyword = selectLogSearchKeyword(nodeExecution.inputs)
    let unverifiedKeywordDetails = []
    for (const secondsPadding of [20, 180]) {
      if (keyword) {
        onProgress(`正在用“${keyword}”筛选子日志…`)
        const keywordDetails = await candidateRunDetails(
          win, appId, nodeExecution, secondsPadding, keyword, onProgress,
        )
        if (keywordDetails.some(detail => inputsContainKeyword(detail.inputs, keyword)))
          return { appId, ranked: rankCandidates(nodeExecution, keywordDetails), direct: false, source }
        unverifiedKeywordDetails = mergeRunDetails(unverifiedKeywordDetails, keywordDetails)
      }

      onProgress(`正在检查执行时间附近 ${secondsPadding} 秒的子日志…`)
      const nearbyDetails = await candidateRunDetails(
        win, appId, nodeExecution, secondsPadding, '', onProgress,
      )
      if (nearbyDetails.length) {
        const details = mergeRunDetails(unverifiedKeywordDetails, nearbyDetails)
        return { appId, ranked: rankCandidates(nodeExecution, details), direct: false, source }
      }
    }
    if (!unverifiedKeywordDetails.length)
      throw new Error('没有找到时间匹配的子日志；调试运行和已清理的日志不会出现在 Logs 中')
    return { appId, ranked: rankCandidates(nodeExecution, unverifiedKeywordDetails), direct: false, source }
  }

  function cachedChildLocation(win, context, nodeExecution, graphNode, onProgress) {
    const key = `${context.appId}:${context.runId}:${nodeExecution.id}`
    if (state.childLocationPromises.has(key)) {
      onProgress('已使用本页缓存，正在打开运行记录…')
      return state.childLocationPromises.get(key)
    }
    const promise = locateChildRun(win, context, nodeExecution, graphNode, onProgress)
    state.childLocationPromises.set(key, promise)
    promise.catch(() => {
      if (state.childLocationPromises.get(key) === promise) state.childLocationPromises.delete(key)
    })
    return promise
  }

  async function locateAndOpen(win, button, context, nodeExecution, graphNode) {
    if (button.disabled) return
    button.disabled = true
    const previous = button.textContent
    button.textContent = '定位中…'
    const pending = win.open('about:blank', '_blank')
    if (pending) {
      if (featureEnabled(win, 'jumpLoading')) renderPendingWindow(pending)
      pending.opener = null
    }
    try {
      const startedAt = Date.now()
      const located = await cachedChildLocation(
        win,
        context,
        nodeExecution,
        graphNode,
        message => updatePendingWindow(pending, message),
      )
      if (!located.ranked.length) throw new Error('没有可打开的子运行')
      if (!located.direct && candidatesAreAmbiguous(located.ranked)) {
        if (pending && !pending.closed) pending.close()
        showCandidatePicker(win, located.appId, located.ranked, located.source)
      } else {
        updatePendingWindow(pending, `已定位，用时 ${((Date.now() - startedAt) / 1000).toFixed(1)} 秒，正在打开详情…`)
        navigateToChild(
          win, pending, located.appId, located.ranked[0].detail.id, located.source,
          located.ranked[0].detail.__difyPlusCursor,
        )
      }
      button.textContent = '已定位 ✓'
      win.setTimeout(() => { button.textContent = previous }, 1800)
    } catch (error) {
      if (pending && !pending.closed) pending.close()
      button.textContent = '定位失败'
      showToast(win.document, error instanceof Error ? error.message : String(error), 7000)
      win.setTimeout(() => { button.textContent = previous }, 2500)
    } finally {
      button.disabled = false
    }
  }

  function navigateToChild(win, pending, appId, runId, source = 'logs', cursor = '') {
    const page = parseAppPath(win.location.pathname) || { basePath: '' }
    const url = source === 'debugging'
      ? buildChildTestRunUrl(win.location.origin, page.basePath, appId, runId, cursor)
      : buildChildLogUrl(win.location.origin, page.basePath, appId, runId)
    let target = pending
    if (!target || target.closed) {
      target = win.open('about:blank', '_blank')
      if (target) {
        if (featureEnabled(win, 'jumpLoading')) renderPendingWindow(target)
        target.opener = null
      }
    }
    if (target && !target.closed) target.location.replace(url)
    else win.open(url, '_blank', 'noopener,noreferrer')
  }

  function showCandidatePicker(win, appId, ranked, source = 'logs') {
    const oldPicker = win.document.getElementById('dify-subworkflow-picker')
    if (oldPicker) oldPicker.remove()
    const overlay = win.document.createElement('div')
    overlay.id = 'dify-subworkflow-picker'
    const panel = win.document.createElement('div')
    const heading = win.document.createElement('h2')
    heading.textContent = source === 'debugging' ? '请选择子工作流测试运行' : '请选择子工作流日志'
    const description = win.document.createElement('p')
    description.textContent = '有多条日志的时间和输入相同，自动选择可能跳错。'
    panel.append(heading, description)
    ranked.slice(0, 8).forEach(item => {
      const button = win.document.createElement('button')
      const time = item.detail.created_at ? new Date(toEpochSeconds(item.detail.created_at) * 1000).toLocaleString() : '未知时间'
      button.textContent = `${time}　${item.detail.status || 'unknown'}　输入匹配 ${(item.inputScore * 100).toFixed(0)}%　${item.detail.id}`
      button.addEventListener('click', () => {
        navigateToChild(win, null, appId, item.detail.id, source, item.detail.__difyPlusCursor)
        overlay.remove()
      })
      panel.appendChild(button)
    })
    const close = win.document.createElement('button')
    close.className = 'dify-picker-close'
    close.textContent = '取消'
    close.addEventListener('click', () => overlay.remove())
    panel.appendChild(close)
    overlay.appendChild(panel)
    overlay.addEventListener('click', event => { if (event.target === overlay) overlay.remove() })
    win.document.body.appendChild(overlay)
  }

  function showToast(doc, message, duration) {
    const oldToast = doc.getElementById('dify-subworkflow-toast')
    if (oldToast) oldToast.remove()
    const toast = doc.createElement('div')
    toast.id = 'dify-subworkflow-toast'
    toast.textContent = message
    doc.body.appendChild(toast)
    setTimeout(() => toast.remove(), duration)
  }

  return {
    QUERY_KEY,
    TEST_QUERY_KEY,
    TEST_CURSOR_KEY,
    asList,
    buildChildLogUrl,
    buildChildTestRunUrl,
    candidatesAreAmbiguous,
    deepFindRunId,
    decodeNestedJson,
    decodeRunPayload,
    destinationFromLocation,
    testDestinationFromLocation,
    debugRunsInTimeWindow,
    findGraphNode,
    flattenComparable,
    inputsContainKeyword,
    formatDecodedEditorValue,
    inputSimilarity,
    installVisibilityRefreshGuard,
    isDifyWorkflowEditor,
    isWorkflowToolGraphNode,
    parseAppPath,
    parseLogApi,
    parseRunListApi,
    parseMaybeJson,
    parseRunApi,
    rankCandidates,
    prefilterCandidateLogs,
    tokenizeJson,
    resolveChildAppId,
    selectLogSearchKeyword,
    rewriteDestinationLogUrl,
    rewriteDestinationTestRunUrl,
    runDetailMatchesSource,
    runSourceForContext,
    runSourceFromPath,
    toEpochSeconds,
    boot,
  }
})
