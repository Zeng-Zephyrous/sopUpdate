  function findPluginsNavButton(win) {
    const doc = win.document
    const direct = [...doc.querySelectorAll('.plugins-nav-button')].find(item => isVisibleElement(win, item))
    if (direct) return direct

    const candidates = new Set()
    for (const selector of [
      'a[href="/plugins"]',
      'a[href$="/plugins"]',
      'a[href="/marketplace"]',
      '[aria-label*="plugin" i]',
      '[title*="plugin" i]',
    ]) {
      for (const item of doc.querySelectorAll(selector))
        candidates.add(item.closest('button, a') || item)
    }
    for (const item of doc.querySelectorAll('button, a')) {
      const text = String(item.textContent || '').trim().toLocaleLowerCase()
      if (text === '插件' || text === 'plugins' || text === 'plugin') candidates.add(item)
    }

    const ranked = [...candidates]
      .filter(item => item.id !== PLUS_BUTTON_ID && isVisibleElement(win, item))
      .map(item => ({ item, rect: item.getBoundingClientRect() }))
      .filter(({ rect }) => rect.top < 120 && rect.right > win.innerWidth * 0.45)
      .sort((left, right) => left.rect.top - right.rect.top || right.rect.right - left.rect.right)
    return ranked.length ? ranked[0].item : null
  }

