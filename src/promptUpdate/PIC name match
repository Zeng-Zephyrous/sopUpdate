输入：
{"contactsList":[{"contactID":"JP00677803","contactName":"JUNG MI HA","email":"miya6011@glovis.net"},{"contactID":"KR00040148","contactName":"Hyun Kook Yoo","email":""}],"split_details":[{"blno":"newBL","new_booking_index":1,"container_details":[{"type":"20Dry","quantity":2}],"need_change_pic":true,"pic":{"name":"Hyun Kook Yoo","email":null}}]}
输出：
{"results":[{"blno":"newBL","new_booking_index":1,"container_details":[{"type":"20Dry","quantity":2}],"contactID":"KR00040148","name":"Hyun Kook Yoo","match_basis":"name","reason":"姓名唯一精确匹配"}]}

