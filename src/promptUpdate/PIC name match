{"contactsList":[{"contactID":"JP00677803","contactName":"JUNG MI HA","email":"miya6011@glovis.net"}],"split_details":[{"blno":"277068588","new_booking_index":null,"container_details":[{"type":"40HD","quantity":1}],"need_change_pic":false,"pic":{"name":null,"email":null}},{"blno":"newBL","new_booking_index":1,"container_details":[{"type":"40HD","quantity":5}],"need_change_pic":true,"pic":{"name":null,"email":"unknown@example.com"}}]}
