{"results":[{"blno":"277068588","new_booking_index":null,"container_details":[{"type":"40HD","quantity":1}],"contactID":"","name":"","match_basis":"not_required","reason":"need_change_pic不为true，无需匹配"},{"blno":"newBL","new_booking_index":1,"container_details":[{"type":"40HD","quantity":5}],"contactID":"","name":"","match_basis":"not_found","reason":"无法唯一匹配联系人"}]}

