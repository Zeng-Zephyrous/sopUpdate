输出：
{"results":[{"blno":"279638692","new_booking_index":0,"container_details":[{"type":"40HD","quantity":3}],"contactID":"","name":"","match_basis":"not_required","reason":"need_change_pic不为true，无需匹配"},{"blno":"newBL","new_booking_index":1,"container_details":[{"type":"40HD","quantity":3}],"contactID":"KR01243322","name":"HYUN KANG","match_basis":"email","reason":"邮箱唯一精确匹配"}]}

